<script>
(function() {
    function shuffle(array) {
        for (let i = array.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [array[i], array[j]] = [array[j], array[i]];
        }
        return array;
    }

    function setupAdBlock(blockEl, maxVisible) {
        const cardsContainer = blockEl.querySelector('.vl-blog-ad-grid, .vl-blog-ad-horizontal');
        if (!cardsContainer) return;
        const cards = Array.from(cardsContainer.querySelectorAll('.vl-blog-ad-card'));
        if (cards.length === 0) return;
        
        shuffle(cards);
        
        cardsContainer.innerHTML = '';
        const visibleCards = cards.slice(0, Math.min(maxVisible, cards.length));
        visibleCards.forEach((card) => {
            card.removeAttribute('style');
            cardsContainer.appendChild(card);
        });
    }

    function vlBlogShuffleAds() {
        const blocks = document.querySelectorAll('.vl-blog-ad-block');
        blocks.forEach(block => {
            const maxVis = parseInt(block.getAttribute('data-max-visible') || '3', 10);
            setupAdBlock(block, maxVis);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', vlBlogShuffleAds);
    } else {
        vlBlogShuffleAds();
    }
})();
</script>
